# ==========================================
# Python & Virtual Environments
# ==========================================
# Ignore virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Package manager caches & build artifacts
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Apache Airflow Specifics
# ==========================================
# Airflow logs (generated at runtime)
logs/

# Airflow local configuration (often generated by `airflow db init` 
# and may contain local overrides or secrets)
airflow.cfg
webserver_config.py

# Airflow local SQLite DB (if running without an external database)
airflow.db
airflow-webserver.pid

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Ignore all local environment files
.env
.env.*
!.env.example

