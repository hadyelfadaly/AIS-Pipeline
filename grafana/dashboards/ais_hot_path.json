{
  "uid": "ais-hot-path",
  "title": "AIS \u2014 Hot Path",
  "tags": [
    "ais",
    "hot-path"
  ],
  "timezone": "Africa/Cairo",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live cargo / tanker vessels",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM live_vessels l JOIN vessels v USING (user_id) WHERE v.is_cargo_or_tanker IS TRUE",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Positions in the last hour",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM positions WHERE event_time > now() - interval '1 hour'",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Newest ping (minutes ago)",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM (now() - max(event_time)))/60)::int FROM live_vessels",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ships reporting in the last hour",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT user_id) FROM positions WHERE event_time > now() - interval '1 hour'",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "geomap",
      "title": "Live vessel map \u2014 cargo & tanker",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.name AS name, l.latitude, l.longitude, l.sog, l.event_time FROM live_vessels l JOIN vessels v USING (user_id) WHERE v.is_cargo_or_tanker IS TRUE AND l.latitude IS NOT NULL",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 27,
          "lon": 33,
          "zoom": 3
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap"
        }
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Vessels by type",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS ships, CASE WHEN ship_type BETWEEN 70 AND 79 THEN 'cargo' WHEN ship_type BETWEEN 80 AND 89 THEN 'tanker' ELSE 'other' END AS type FROM vessels WHERE is_cargo_or_tanker GROUP BY 2 ORDER BY 1 DESC",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Positions per minute",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(event_time,'1m'), count(*) AS positions FROM positions WHERE $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Latest reported vessels",
      "datasource": {
        "type": "postgres",
        "uid": "ais-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ais-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.name, v.ship_type, l.latitude, l.longitude, l.sog, l.event_time FROM live_vessels l JOIN vessels v USING (user_id) WHERE v.is_cargo_or_tanker IS TRUE ORDER BY l.event_time DESC LIMIT 25",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "overrides": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}